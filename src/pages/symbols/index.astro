---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyButton from '../../components/CopyButton.astro';
import { characterCategories, featuredCharacters, charactersForCategory } from '../../data/characters';

const title = 'Special Characters & Symbols — Copy & Paste | Character Toolbox';
const description = 'Copy and paste useful special characters and Unicode symbols by category, including math, currency, arrows, punctuation, check marks and legal symbols.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Symbols', item: new URL('/symbols/', Astro.site ?? Astro.url.origin).href }
  ]
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <header class="content-header">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> <span aria-hidden="true">/</span> Symbols</div>
      <h1>Special Characters & Symbols</h1>
      <p class="lead">Browse practical Unicode symbols by purpose, copy them immediately, and open reviewed character guides when verified typing and code information is available.</p>
    </div>
  </header>

  <section class="section" style="padding-top: 0" aria-labelledby="symbol-categories">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="symbol-categories">Browse by category</h2>
          <p>Stable, meaningful collections instead of thousands of thin filter pages.</p>
        </div>
        <div class="section-actions">
          <a class="text-link" href="/tools/copy-paste-symbols/">Browse 1,300+ copy/paste symbols</a>
          <a class="cta-link" href="/unicode/">Search all Unicode</a>
        </div>
      </div>

      <div class="category-grid">
        {characterCategories.map((category) => {
          const count = charactersForCategory(category.slug).length;
          return (
            <a class="category-card" href={`/symbols/${category.slug}/`}>
              <strong>{category.name}</strong>
              <span>{category.intro}</span>
              <small>{count} curated symbols</small>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-soft" aria-labelledby="popular-symbols">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="popular-symbols">Quick copy essentials</h2>
          <p>Frequently useful special characters with one-click copy.</p>
        </div>
      </div>

      <div class="symbol-grid">
        {featuredCharacters.map((item) => (
          <article class="symbol-card">
            <span class="symbol-glyph" aria-hidden="true">{item.character}</span>
            <div class="symbol-info">
              {item.href ? <a class="symbol-link" href={item.href}><strong>{item.name}</strong></a> : <strong>{item.name}</strong>}
              <span>{item.codePoint} · {item.category}</span>
            </div>
            <CopyButton value={item.character} label={`Copy ${item.name}`} />
          </article>
        ))}
      </div>

      <div class="content-note symbols-explainer">
        <h2>What counts as a special character?</h2>
        <p>Special characters are symbols and marks outside ordinary letters and digits, such as ©, →, ±, €, § and typographic punctuation. This toolbox keeps common characters in practical categories while the <a href="/unicode/">Unicode Explorer</a> handles the much larger Unicode 18.0 repertoire.</p>
        <p>Need more visual choices? Open the <a href="/tools/copy-paste-symbols/">1,300+ Copy & Paste Symbols catalog</a>. Need a blank or zero-width character rather than a visible symbol? Use the <a href="/tools/invisible-characters/">Invisible Characters tool</a>. For keyboard methods, use the <a href="/tools/shortcut-finder/">Shortcut Finder</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
