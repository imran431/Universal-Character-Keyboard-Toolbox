---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Character Toolbox" description="The requested page could not be found." robots="noindex,follow">
  <section class="content-header">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lead">That character page does not exist yet. Start with the symbol browser or search from the homepage.</p>
      <p><a class="cta-link" href="/">Go to homepage</a></p>
    </div>
  </section>
</BaseLayout>
