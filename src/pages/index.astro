---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import { featuredCharacters } from '../data/characters';

const title = 'Special Characters & Unicode Symbols | Character Toolbox';
const description = 'Find, copy and type special characters, Unicode symbols, accents and keyboard symbols. Search by name, character, alias or code point instantly.';
---
<BaseLayout title={title} description={description}>
  <section class="hero" aria-labelledby="page-title">
    <div class="container">
      <span class="eyebrow">Fast · browser-first · no account</span>
      <h1 id="page-title">Find any character. Copy it instantly.</h1>
      <p class="hero-copy">Search Unicode names, common symbols, exact characters and code points. Get the character first, then open verified typing details when available.</p>

      <div class="search-shell" id="search">
        <label class="sr-only" for="character-search">Search characters</label>
        <div class="search-row">
          <input
            id="character-search"
            class="search-input"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Try degree, snowman, →, tick, U+00B0…"
            data-character-search
          />
          <span class="search-kbd" aria-hidden="true">Unicode 18</span>
        </div>
      </div>
      <p class="search-hint" data-search-status aria-live="polite">Search by name, alias, character, code point, or HTML numeric entity.</p>

      <div class="quick-searches" aria-label="Try a popular character search">
        <span>Try:</span>
        <button type="button" data-search-example="degree">° Degree</button>
        <button type="button" data-search-example="check mark">✓ Check mark</button>
        <button type="button" data-search-example="right arrow">→ Arrow</button>
        <button type="button" data-search-example="em dash">— Em dash</button>
        <button type="button" data-search-example="euro">€ Euro</button>
        <button type="button" data-search-example="snowman">☃ Snowman</button>
      </div>
    </div>
  </section>

  <section class="section unicode-results-section" data-unicode-results hidden aria-labelledby="unicode-results-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="unicode-results-heading">Search results</h2>
          <p data-result-summary>Unicode matches appear here.</p>
        </div>
      </div>
      <div class="symbol-grid" data-unicode-result-grid></div>
      <p class="search-footnote">Character names come from the Unicode Character Database. Typing shortcuts are added separately only after verification.</p>
    </div>
  </section>

  <section class="section" data-popular-section aria-labelledby="popular-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2 id="popular-heading">Popular characters</h2>
          <p>Copy common symbols without opening another page.</p>
        </div>
        <a class="cta-link" href="/symbols/">Browse symbols →</a>
      </div>

      <nav class="category-pill-row" aria-label="Browse popular symbol categories">
        <a href="/symbols/math/">Math & science</a>
        <a href="/symbols/arrows/">Arrows</a>
        <a href="/symbols/currency/">Currency</a>
        <a href="/symbols/punctuation/">Punctuation</a>
        <a href="/symbols/status/">Check marks</a>
        <a href="/symbols/legal/">Legal & business</a>
      </nav>

      <div class="symbol-grid">
        {featuredCharacters.map((item) => (
          <article class="symbol-card">
            <span class="symbol-glyph" aria-hidden="true">{item.character}</span>
            <div class="symbol-info">
              {item.href ? (
                <a class="symbol-link" href={item.href}><strong>{item.name}</strong></a>
              ) : (
                <strong>{item.name}</strong>
              )}
              <span>{item.codePoint}</span>
            </div>
            <CopyButton
              value={item.character}
              label={`Copy ${item.name}`}
              characterName={item.name}
              codePoint={item.codePoint}
              href={item.href ?? ''}
            />
          </article>
        ))}
      </div>

      <section class="home-tools" aria-labelledby="home-tools-heading">
        <div class="section-heading compact-heading">
          <div>
            <h2 id="home-tools-heading">Useful character tools</h2>
            <p>Use the fastest path for the job instead of digging through a giant character table.</p>
          </div>
          <a class="text-link" href="/tools/">View all tools</a>
        </div>

        <div class="home-tools-grid">
          <a class="home-tool-card" href="/tools/copy-paste-symbols/">
            <span class="home-tool-icon" aria-hidden="true">✦</span>
            <span><strong>Copy & Paste Symbols</strong><small>Browse 1,300+ visual characters</small></span>
          </a>
          <a class="home-tool-card" href="/tools/shortcut-finder/">
            <span class="home-tool-icon" aria-hidden="true">⌨</span>
            <span><strong>Shortcut Finder</strong><small>Windows, Mac & Word methods</small></span>
          </a>
          <a class="home-tool-card" href="/tools/accent-keyboard/">
            <span class="home-tool-icon" aria-hidden="true">á</span>
            <span><strong>Accent Keyboard</strong><small>Build and copy 500+ Latin variants</small></span>
          </a>
          <a class="home-tool-card" href="/tools/unicode-converter/">
            <span class="home-tool-icon" aria-hidden="true">U+</span>
            <span><strong>Unicode Converter</strong><small>Text, HTML, JS & code points</small></span>
          </a>
          <a class="home-tool-card" href="/tools/alt-code-finder/">
            <span class="home-tool-icon" aria-hidden="true">Alt</span>
            <span><strong>Alt Code Finder</strong><small>Reviewed Windows Alt codes</small></span>
          </a>
          <a class="home-tool-card" href="/tools/invisible-characters/">
            <span class="home-tool-icon" aria-hidden="true">␠</span>
            <span><strong>Invisible Characters</strong><small>Blank, thin & zero-width spaces</small></span>
          </a>
          <a class="home-tool-card" href="/library/">
            <span class="home-tool-icon" aria-hidden="true">★</span>
            <span><strong>Saved Characters</strong><small>Favorites and recent symbols</small></span>
          </a>
          <a class="home-tool-card" href="/guides/">
            <span class="home-tool-icon" aria-hidden="true">?</span>
            <span><strong>Typing Guides</strong><small>Windows, Mac, apps & mobile</small></span>
          </a>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { allCuratedCharacters } from '../data/characters';
  import { searchCharacterRecords } from '../lib/character-search';
  import {
    isFavoriteCharacter,
    rememberRecentCharacter,
    toggleFavoriteCharacter
  } from '../lib/character-library';

  interface WorkerResult {
    codePoint: number;
    character: string;
    name: string;
    aliases: string[];
    block: string;
    category: string;
    score: number;
  }

  interface WorkerResponse {
    id: number;
    ok: boolean;
    results?: WorkerResult[];
    error?: string;
  }

  const input = document.querySelector<HTMLInputElement>('[data-character-search]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const resultSection = document.querySelector<HTMLElement>('[data-unicode-results]');
  const resultGrid = document.querySelector<HTMLElement>('[data-unicode-result-grid]');
  const resultSummary = document.querySelector<HTMLElement>('[data-result-summary]');
  const popularSection = document.querySelector<HTMLElement>('[data-popular-section]');
  const searchExamples = document.querySelectorAll<HTMLButtonElement>('[data-search-example]');

  const curatedHrefByCodePoint = new Map<number, string>();
  for (const item of allCuratedCharacters) {
    if (!item.href) continue;
    const codePoint = Number.parseInt(item.codePoint.replace(/^U\+/i, ''), 16);
    curatedHrefByCodePoint.set(codePoint, item.href);
  }

  let worker: Worker | null = null;
  let requestId = 0;
  let debounceTimer = 0;

  function codePointLabel(codePoint: number) {
    return `U+${codePoint.toString(16).toUpperCase().padStart(4, '0')}`;
  }

  function displayGlyph(result: WorkerResult) {
    if (result.category.startsWith('M')) return `◌${result.character}`;
    if (result.category === 'Cf' || result.category === 'Cc' || result.character.trim() === '') return '□';
    return result.character;
  }

  function featuredResults(query: string): WorkerResult[] {
    return searchCharacterRecords(allCuratedCharacters, query).map(({ record, score }) => ({
      codePoint: Number.parseInt(record.codePoint.replace(/^U\+/i, ''), 16),
      character: record.character,
      name: record.name,
      aliases: record.aliases,
      block: '',
      category: '',
      score: score + 100
    }));
  }

  function mergeResults(primary: WorkerResult[], secondary: WorkerResult[]) {
    const merged = new Map<number, WorkerResult>();

    for (const result of primary) {
      merged.set(result.codePoint, result);
    }

    for (const result of secondary) {
      const current = merged.get(result.codePoint);

      if (!current) {
        merged.set(result.codePoint, result);
        continue;
      }

      merged.set(result.codePoint, {
        ...current,
        block: result.block || current.block,
        category: result.category || current.category,
        score: Math.max(current.score, result.score)
      });
    }

    return [...merged.values()]
      .sort((a, b) => b.score - a.score || a.codePoint - b.codePoint)
      .slice(0, 24);
  }

  function createResultCard(result: WorkerResult) {
    const article = document.createElement('article');
    article.className = 'symbol-card';

    const glyph = document.createElement('span');
    glyph.className = 'symbol-glyph';
    glyph.setAttribute('aria-hidden', 'true');
    glyph.textContent = displayGlyph(result);

    const info = document.createElement('div');
    info.className = 'symbol-info';

    const href = curatedHrefByCodePoint.get(result.codePoint);
    if (href) {
      const link = document.createElement('a');
      link.className = 'symbol-link';
      link.href = href;
      const strong = document.createElement('strong');
      strong.textContent = result.name;
      link.append(strong);
      info.append(link);
    } else {
      const strong = document.createElement('strong');
      strong.textContent = result.name;
      info.append(strong);
    }

    const meta = document.createElement('span');
    meta.textContent = [codePointLabel(result.codePoint), result.block].filter(Boolean).join(' · ');
    info.append(meta);

    const favorite = document.createElement('button');
    favorite.className = 'inline-favorite-button';
    favorite.type = 'button';
    favorite.dataset.favoriteResult = result.character;
    favorite.dataset.favoriteName = result.name;
    favorite.dataset.favoriteCodePoint = codePointLabel(result.codePoint);
    if (href) favorite.dataset.favoriteHref = href;
    const isFavorite = isFavoriteCharacter(result.character);
    favorite.setAttribute('aria-pressed', String(isFavorite));
    favorite.setAttribute(
      'aria-label',
      isFavorite ? `Remove ${result.name} from favorites` : `Add ${result.name} to favorites`
    );
    favorite.textContent = isFavorite ? '★ Saved' : '☆ Save';
    info.append(favorite);

    const copy = document.createElement('button');
    copy.className = 'copy-button';
    copy.type = 'button';
    copy.dataset.resultCopy = result.character;
    copy.dataset.resultName = result.name;
    copy.dataset.resultCodePoint = codePointLabel(result.codePoint);
    if (href) copy.dataset.resultHref = href;
    copy.setAttribute('aria-label', `Copy ${result.name}`);
    copy.textContent = 'Copy';

    article.append(glyph, info, copy);
    return article;
  }

  function renderResults(results: WorkerResult[]) {
    if (!resultGrid || !resultSection) return;

    resultGrid.replaceChildren();

    if (results.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'search-empty';
      const heading = document.createElement('strong');
      heading.textContent = 'No matching named character found.';
      const copy = document.createElement('p');
      copy.textContent = 'Try a Unicode code point such as U+2192, paste the character itself, or use fewer words.';
      empty.append(heading, copy);
      resultGrid.append(empty);
      return;
    }

    const fragment = document.createDocumentFragment();
    for (const result of results) fragment.append(createResultCard(result));
    resultGrid.append(fragment);
  }

  function ensureWorker() {
    if (!worker) {
      worker = new Worker(new URL('../workers/unicode-search.worker.ts', import.meta.url), {
        type: 'module'
      });

      worker.addEventListener('message', (event: MessageEvent<WorkerResponse>) => {
        if (!input || event.data.id !== requestId) return;

        const local = featuredResults(input.value);

        if (!event.data.ok) {
          const fallback = mergeResults(local, []);
          renderResults(fallback);
          if (status) status.textContent = fallback.length
            ? 'Showing curated matches. The full Unicode index is temporarily unavailable.'
            : 'The full Unicode index is temporarily unavailable.';
          if (resultSummary) resultSummary.textContent = 'Curated character matches';
          return;
        }

        const results = mergeResults(local, event.data.results ?? []);
        renderResults(results);

        if (resultSummary) {
          resultSummary.textContent = results.length === 24
            ? 'Showing the strongest 24 matches from Unicode 18.0.'
            : `${results.length} ${results.length === 1 ? 'match' : 'matches'} from Unicode 18.0.`;
        }

        if (status) {
          status.textContent = results.length
            ? 'Results ready. Exact characters and code points rank first.'
            : 'No matching named character found.';
        }
      });
    }

    return worker;
  }

  function runSearch() {
    if (!input || !resultSection || !popularSection) return;

    const query = input.value.trim();
    requestId += 1;

    if (!query) {
      resultSection.hidden = true;
      popularSection.hidden = false;
      if (status) status.textContent = 'Search by name, alias, character, code point, or HTML numeric entity.';
      return;
    }

    popularSection.hidden = true;
    resultSection.hidden = false;

    const local = featuredResults(query);
    renderResults(local);
    if (resultSummary) resultSummary.textContent = local.length ? 'Checking the full Unicode index…' : 'Searching Unicode 18.0…';
    if (status) status.textContent = 'Searching the Unicode 18.0 index…';

    const currentId = requestId;
    ensureWorker().postMessage({ id: currentId, query, limit: 24 });
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(runSearch, 100);
  });

  for (const example of searchExamples) {
    example.addEventListener('click', () => {
      if (!input) return;
      input.value = example.dataset.searchExample ?? '';
      input.focus();
      runSearch();
    });
  }

  resultGrid?.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;

    if (target.dataset.favoriteResult) {
      const isFavorite = toggleFavoriteCharacter({
        character: target.dataset.favoriteResult,
        name: target.dataset.favoriteName || 'Unicode character',
        codePoint: target.dataset.favoriteCodePoint || '',
        href: target.dataset.favoriteHref || undefined
      });
      target.setAttribute('aria-pressed', String(isFavorite));
      target.setAttribute(
        'aria-label',
        isFavorite
          ? `Remove ${target.dataset.favoriteName || 'character'} from favorites`
          : `Add ${target.dataset.favoriteName || 'character'} to favorites`
      );
      target.textContent = isFavorite ? '★ Saved' : '☆ Save';
      return;
    }

    if (!target.dataset.resultCopy) return;

    const original = target.textContent ?? 'Copy';

    try {
      await navigator.clipboard.writeText(target.dataset.resultCopy);
      rememberRecentCharacter({
        character: target.dataset.resultCopy,
        name: target.dataset.resultName || 'Unicode character',
        codePoint: target.dataset.resultCodePoint || '',
        href: target.dataset.resultHref || undefined
      });
      target.textContent = 'Copied';
      target.dataset.copied = 'true';
    } catch {
      target.textContent = 'Try again';
      target.dataset.copyFailed = 'true';
    }

    window.setTimeout(() => {
      target.textContent = original;
      target.dataset.copied = 'false';
      target.dataset.copyFailed = 'false';
    }, 1400);
  });
</script>
