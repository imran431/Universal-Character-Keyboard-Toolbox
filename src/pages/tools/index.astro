---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Character & Unicode Tools | Character Toolbox';
const description = 'Use free browser-based tools to find special-character shortcuts, verified Alt codes, Unicode characters and typing methods without an account.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools/', Astro.site ?? Astro.url.origin).href }
  ]
};

const tools = [
  {
    href: '/tools/copy-paste-symbols/',
    title: 'Copy & Paste Symbols',
    desc: 'Browse 1,300+ arrows, math signs, Greek letters, fractions, shapes, box drawing, punctuation and more.',
    badge: 'Large visual symbol catalog',
    icon: '✦',
    color: 'icon-cyan',
    featured: true
  },
  {
    href: '/tools/shortcut-finder/',
    title: 'Shortcut Finder',
    desc: 'Search reviewed Windows, macOS and Microsoft Word methods for high-value special characters.',
    badge: 'Verified methods only',
    icon: '⌨',
    color: 'icon-indigo'
  },
  {
    href: '/tools/alt-code-finder/',
    title: 'Alt Code Finder',
    desc: 'Find Windows Alt codes that are explicitly documented in our reviewed source set.',
    badge: 'No generated or guessed Alt codes',
    icon: 'Alt',
    color: 'icon-rose'
  },
  {
    href: '/tools/font-generator/',
    title: 'Fancy Font Generator',
    desc: 'Transform plain text into stylish Unicode styles: bold, cursive script, gothic, monospace, and bubbles.',
    badge: '13 instant text styles',
    icon: '𝕱',
    color: 'icon-blue'
  },
  {
    href: '/tools/accent-keyboard/',
    title: 'Accent Keyboard',
    desc: 'Build and copy 500+ accented Latin letters with A-Z, language and case filters plus a browser-based writing pad.',
    badge: 'Accents, ligatures & special Latin letters',
    icon: 'é',
    color: 'icon-purple'
  },
  {
    href: '/letters/',
    title: 'Letters With Accents A-Z',
    desc: 'Browse dedicated A-Z guides with copyable variants, Unicode code points and reliable Word, Windows, Mac and Docs methods.',
    badge: '26 letter guides from one reviewed dataset',
    icon: 'A-Z',
    color: 'icon-teal'
  },
  {
    href: '/tools/diacritics-keyboard/',
    title: 'Combining Diacritics Keyboard',
    desc: 'Type a base letter, add Unicode combining marks above or below it, and normalize the result to NFC or NFD.',
    badge: '25 combining marks + Unicode normalization',
    icon: '◌́',
    color: 'icon-violet'
  },
  {
    href: '/tools/unicode-converter/',
    title: 'Unicode Converter',
    desc: 'Convert text to code points, HTML, JavaScript and CSS notation, or decode Unicode notation back to text.',
    badge: 'Bidirectional conversion',
    icon: 'U+',
    color: 'icon-teal'
  },
  {
    href: '/tools/invisible-characters/',
    title: 'Invisible Characters',
    desc: 'Copy no-break, thin, hair and zero-width spaces, then reveal hidden spacing inside pasted text.',
    badge: 'Blank-space copy & text inspection',
    icon: '␠',
    color: 'icon-orange'
  },
  {
    href: '/library/',
    title: 'Saved Characters',
    desc: 'Reuse favorites and recently used characters stored locally in this browser.',
    badge: 'Private, local and account-free',
    icon: '★',
    color: 'icon-pink'
  },
  {
    href: '/unicode/',
    title: 'Unicode Explorer',
    desc: 'Search Unicode 18.0 by official name, alias, exact character or code point.',
    badge: '46k+ explicit names + algorithmic ranges',
    icon: '⌘',
    color: 'icon-sky'
  },
  {
    href: '/typing/',
    title: 'Typing Methods',
    desc: 'Understand the reliable ways to insert special characters on Windows, Mac and Microsoft Word.',
    badge: 'Platform-aware guidance',
    icon: '⌨',
    color: 'icon-indigo'
  },
  {
    href: '/guides/',
    title: 'Typing Guides',
    desc: 'Read detailed Windows, Mac, Word, Google Docs, iPhone and math-symbol instructions with reviewed sources.',
    badge: 'Long-form troubleshooting & how-to guides',
    icon: '📚',
    color: 'icon-purple'
  }
];
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <header class="content-header">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> <span aria-hidden="true">/</span> Tools</div>
      <h1>Character &amp; <span class="hero-gradient-text">Unicode Tools</span></h1>
      <p class="lead">Fast browser tools for finding characters, verified typing methods, Unicode data and documented Alt codes.</p>
    </div>
  </header>

  <section class="section" style="padding-top: 0" aria-labelledby="tool-list">
    <div class="container">
      <div class="category-grid" id="tool-list">
        {tools.map((tool) => (
          <a class={`category-card ${tool.featured ? 'category-card-featured' : ''}`} href={tool.href}>
            <div class="category-card-top">
              <span class={`home-tool-icon ${tool.color}`} aria-hidden="true">{tool.icon}</span>
              {tool.featured && <span class="category-card-badge">Popular</span>}
            </div>
            <strong>{tool.title}</strong>
            <span>{tool.desc}</span>
            <small>{tool.badge}</small>
          </a>
        ))}
      </div>

      <div class="content-note">
        <h2>Browser-first by design</h2>
        <p>These tools run in the browser and do not require an account. Search and filtering are handled locally with static data prepared during the site build.</p>
        <p>Tool pages are kept separate from mass-generated character reference pages so product coverage can grow without turning the site into a thin-content index.</p>
      </div>
    </div>
  </section>
</BaseLayout>
