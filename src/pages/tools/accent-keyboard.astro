---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { accentLanguages, allAccentCharacters } from '../../data/accent-characters';

const title = 'Accent Keyboard — 500+ Accented Letters & Latin Characters';
const description = 'Build, filter, type and copy 500+ accented Latin letters across A-Z, including acute, grave, circumflex, tilde, diaeresis, caron, macron and more.';

const builderBases = [...new Set(
  allAccentCharacters
    .filter((item) => item.base.length === 1)
    .map((item) => item.base.toLocaleLowerCase())
)].sort();

const builderAccents = [...new Set(
  allAccentCharacters
    .filter((item) => item.base.length === 1)
    .map((item) => item.accent)
)].sort();

const accentReference = [
  { name: 'Acute', mark: '◌́', examples: 'á é í ó ú', note: 'A rising mark used in many Latin-script languages.' },
  { name: 'Grave', mark: '◌̀', examples: 'à è ì ò ù', note: 'A falling mark common in languages including French and Italian.' },
  { name: 'Circumflex', mark: '◌̂', examples: 'â ê î ô û', note: 'A roof-shaped mark used in several European and transliteration systems.' },
  { name: 'Tilde', mark: '◌̃', examples: 'ã ñ õ', note: 'A wavy mark used prominently in Spanish and Portuguese.' },
  { name: 'Diaeresis', mark: '◌̈', examples: 'ä ë ï ö ü', note: 'Two dots used as diaeresis or umlaut depending on language and context.' },
  { name: 'Cedilla', mark: '◌̧', examples: 'ç ş ţ', note: 'A hook-like mark placed below certain consonants.' },
  { name: 'Caron', mark: '◌̌', examples: 'č ě ň ř š ž', note: 'A small wedge used in several Central and Eastern European languages.' },
  { name: 'Macron', mark: '◌̄', examples: 'ā ē ī ō ū', note: 'A horizontal line commonly used for vowel length and transliteration.' },
  { name: 'Breve', mark: '◌̆', examples: 'ă ĕ ĭ ŏ ŭ', note: 'A curved mark used in multiple orthographies and phonetic systems.' },
  { name: 'Ogonek', mark: '◌̨', examples: 'ą ę į ų', note: 'A small tail below a letter, used notably in Polish and other orthographies.' },
  { name: 'Dot below', mark: '◌̣', examples: 'ạ ẹ ị ọ ụ', note: 'A below-letter dot common in Vietnamese and many transliteration systems.' },
  { name: 'Ring above', mark: '◌̊', examples: 'å ů', note: 'A small ring used in Scandinavian languages and selected Central European forms.' }
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 3, name: 'Accent Keyboard', item: new URL('/tools/accent-keyboard/', Astro.site ?? Astro.url.origin).href }
  ]
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <header class="content-header">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/tools/">Tools</a>
        <span aria-hidden="true">/</span>
        Accent Keyboard
      </div>
      <h1>Accent Keyboard & Letter Builder</h1>
      <p class="lead">Build and copy accented Latin letters across A-Z, filter by language or base letter, and collect multiple characters in the writing pad. Everything runs locally in your browser.</p>
    </div>
  </header>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="tool-panel">
        <label class="explorer-label" for="accent-search">Search accented characters</label>
        <div class="search-shell tool-search-shell">
          <div class="search-row">
            <input id="accent-search" class="search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Try a, acute, tilde, diaeresis, cedilla…" data-accent-search />
            <span class="search-kbd" aria-hidden="true">Latin</span>
          </div>
        </div>

        <div class="accent-filter-groups">
          <div>
            <span class="accent-filter-label">Case</span>
            <div class="typing-selector tool-filter" role="group" aria-label="Filter accent letter case">
              <button type="button" data-accent-case="all" aria-pressed="true">All</button>
              <button type="button" data-accent-case="lower" aria-pressed="false">Lowercase</button>
              <button type="button" data-accent-case="upper" aria-pressed="false">Uppercase</button>
            </div>
          </div>

          <div>
            <span class="accent-filter-label">Language</span>
            <div class="accent-filter-row" role="group" aria-label="Filter accented letters by language">
              <button type="button" data-accent-language="all" aria-pressed="true">All</button>
              {accentLanguages.map((language) => (
                <button type="button" data-accent-language={language} aria-pressed="false">{language}</button>
              ))}
            </div>
          </div>

          <div>
            <span class="accent-filter-label">Base letter</span>
            <div class="accent-filter-row accent-letter-filter" role="group" aria-label="Filter by base letter">
              <button type="button" data-accent-letter="all" aria-pressed="true">All</button>
              {builderBases.map((base) => (
                <button type="button" data-accent-letter={base} aria-pressed="false">{base.toLocaleUpperCase()}</button>
              ))}
            </div>
          </div>
        </div>

        <p class="search-hint" data-accent-status aria-live="polite">{allAccentCharacters.length} accented and special Latin characters available.</p>
      </div>

      <div class="accent-workspace">
        <section class="accent-builder-card" aria-labelledby="accent-builder-heading">
          <div class="accent-builder-heading">
            <div>
              <h2 id="accent-builder-heading">Accent letter builder</h2>
              <p>Choose a base letter and accent type. The builder only offers combinations that exist in the reviewed keyboard data.</p>
            </div>
            <span class="method-platform">Builder</span>
          </div>

          <div class="accent-builder-step">
            <strong>1. Base letter</strong>
            <div class="accent-builder-options" role="group" aria-label="Choose base letter">
              {builderBases.map((base) => (
                <button type="button" data-builder-base={base} aria-pressed="false">{base.toLocaleUpperCase()}</button>
              ))}
            </div>
          </div>

          <div class="accent-builder-step">
            <strong>2. Accent type</strong>
            <div class="accent-builder-options accent-builder-accents" role="group" aria-label="Choose accent type">
              {builderAccents.map((accent) => (
                <button type="button" data-builder-accent={accent} aria-pressed="false">{accent}</button>
              ))}
            </div>
          </div>

          <div class="accent-builder-result" data-builder-result>
            <div>
              <span class="converter-label">Lowercase</span>
              <button type="button" class="accent-builder-character" data-builder-lower disabled aria-label="Insert lowercase accented letter">?</button>
            </div>
            <div>
              <span class="converter-label">Uppercase</span>
              <button type="button" class="accent-builder-character" data-builder-upper disabled aria-label="Insert uppercase accented letter">?</button>
            </div>
            <p class="search-hint" data-builder-status aria-live="polite">Choose a base letter and an accent type.</p>
          </div>
        </section>

        <section class="accent-pad-card" aria-labelledby="writing-pad">
          <div class="accent-pad-heading">
            <div>
              <h2 id="writing-pad">Writing pad</h2>
              <p>Click a letter to copy it immediately and add it at the cursor.</p>
            </div>
            <div class="accent-pad-actions">
              <button type="button" class="copy-button" data-copy-pad>Copy text</button>
              <button type="button" class="source-mini-link accent-clear-button" data-clear-pad>Clear</button>
            </div>
          </div>
          <textarea class="test-field accent-pad" aria-label="Accent keyboard writing pad" placeholder="Build or paste text here…" data-accent-pad></textarea>
          <p class="search-hint" data-pad-status aria-live="polite">Nothing typed yet.</p>
        </section>

        <section aria-labelledby="accent-characters">
          <div class="section-heading compact-heading">
            <div>
              <h2 id="accent-characters">Quick copy keyboard</h2>
              <p>Filter hundreds of precomposed Latin letters, then click a character to copy it and add it to the writing pad.</p>
            </div>
            <div class="section-actions">
              <button type="button" class="source-mini-link" data-copy-visible>Copy shown</button>
              <button type="button" class="source-mini-link accent-clear-button" data-reset-accent-filters>Reset filters</button>
            </div>
          </div>

          <div class="accent-grid" data-accent-grid>
            {allAccentCharacters.map((item) => (
              <button
                type="button"
                class="accent-key"
                data-accent-key
                data-character={item.character}
                data-case={item.case}
                data-base={item.base}
                data-languages={item.languages.join('|')}
                data-search={`${item.character} ${item.label} ${item.base} ${item.accent} ${item.languages.join(' ')}`.toLocaleLowerCase()}
                aria-label={`Insert ${item.label}: ${item.character}`}
              >
                <span class="accent-key-glyph" aria-hidden="true">{item.character}</span>
                <span class="accent-key-label">{item.label}</span>
              </button>
            ))}
          </div>

          <div class="search-empty shortcut-empty" data-accent-empty hidden>
            <strong>No accent matched that search.</strong>
            <p>Try a base letter such as <strong>a</strong>, or an accent name such as <strong>acute</strong>, <strong>tilde</strong> or <strong>cedilla</strong>.</p>
          </div>
        </section>
      </div>

      <section class="content-note accent-reference-section" aria-labelledby="accent-reference-heading">
        <div class="section-heading compact-heading">
          <div>
            <h2 id="accent-reference-heading">Accent mark reference</h2>
            <p>Use these common mark families to recognize the form you need before filtering the keyboard.</p>
          </div>
        </div>
        <div class="accent-reference-grid">
          {accentReference.map((item) => (
            <article class="accent-reference-card">
              <span class="accent-reference-mark" aria-hidden="true">{item.mark}</span>
              <div>
                <strong>{item.name}</strong>
                <span>{item.examples}</span>
                <p>{item.note}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="info-grid tool-info-grid">
        <section class="info-card">
          <h2>What this keyboard covers</h2>
          <p>The keyboard includes precomposed Latin letters from the core Latin-1, Latin Extended and Latin Additional ranges when they decompose to A-Z plus documented combining marks, along with selected special Latin letters such as stroke, hook, eth, thorn and ligature forms.</p>
        </section>
        <section class="info-card">
          <h2>Need a different character?</h2>
          <p>Browse the <a href="/letters/">A-Z accent guides</a> for letter-specific copy and typing references, or use the <a href="/unicode/">Unicode Explorer</a> to search the larger Unicode 18.0 database by name, character or code point.</p>
        </section>
      </div>

      <section class="content-note" aria-labelledby="accent-faq-heading">
        <h2 id="accent-faq-heading">Frequently asked accent questions</h2>
        <h3>What is the safest way to enter an accented letter?</h3>
        <p>Copying the exact Unicode character is the most consistent cross-platform method. For frequent typing, a language keyboard or a documented platform shortcut may be faster.</p>
        <h3>Why does an accent shortcut work on one keyboard but not another?</h3>
        <p>Keyboard shortcuts can depend on the active operating system, app and keyboard layout. This tool avoids guessing layout-specific shortcuts and keeps the characters themselves available for direct copy.</p>
        <h3>What if I need to stack marks or add an accent that has no precomposed letter?</h3>
        <p>Use the <a href="/tools/diacritics-keyboard/">Combining Diacritics Keyboard</a>. It inserts Unicode combining marks and can normalize the result to NFC or NFD.</p>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  import { allAccentCharacters as builderCharacters } from '../../data/accent-characters';
  import { rememberRecentCharacter } from '../../lib/character-library';

  const search = document.querySelector<HTMLInputElement>('[data-accent-search]');
  const keys = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-accent-key]'));
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-accent-case]'));
  const languageFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-accent-language]'));
  const letterFilters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-accent-letter]'));
  const copyVisible = document.querySelector<HTMLButtonElement>('[data-copy-visible]');
  const resetFilters = document.querySelector<HTMLButtonElement>('[data-reset-accent-filters]');
  const status = document.querySelector<HTMLElement>('[data-accent-status]');
  const empty = document.querySelector<HTMLElement>('[data-accent-empty]');
  const pad = document.querySelector<HTMLTextAreaElement>('[data-accent-pad]');
  const copyPad = document.querySelector<HTMLButtonElement>('[data-copy-pad]');
  const clearPad = document.querySelector<HTMLButtonElement>('[data-clear-pad]');
  const padStatus = document.querySelector<HTMLElement>('[data-pad-status]');
  const builderBaseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-builder-base]'));
  const builderAccentButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-builder-accent]'));
  const builderLower = document.querySelector<HTMLButtonElement>('[data-builder-lower]');
  const builderUpper = document.querySelector<HTMLButtonElement>('[data-builder-upper]');
  const builderStatus = document.querySelector<HTMLElement>('[data-builder-status]');

  let selectedCase = 'all';
  let selectedLanguage = 'all';
  let selectedLetter = 'all';
  let selectedBase = '';
  let selectedAccent = '';

  function normalize(value: string) {
    return value.trim().toLocaleLowerCase().replace(/[\s_-]+/g, ' ');
  }

  async function writeClipboard(value: string) {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        // Fall through for local previews and restricted browser contexts.
      }
    }

    const textarea = document.createElement('textarea');
    textarea.value = value;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.inset = '0 auto auto -9999px';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();

    let copied = false;
    try {
      copied = document.execCommand('copy');
    } finally {
      textarea.remove();
    }

    return copied;
  }

  function updateFilter() {
    const query = normalize(search?.value ?? '');
    let visible = 0;

    for (const key of keys) {
      const matchesCase = selectedCase === 'all' || key.dataset.case === selectedCase;
      const matchesLanguage = selectedLanguage === 'all' ||
        (key.dataset.languages ?? '').split('|').includes(selectedLanguage);
      const matchesLetter = selectedLetter === 'all' || key.dataset.base === selectedLetter;
      const matchesQuery = query.length === 0 || normalize(key.dataset.search ?? '').includes(query);
      key.hidden = !(matchesCase && matchesLanguage && matchesLetter && matchesQuery);
      if (!key.hidden) visible += 1;
    }

    if (empty) empty.hidden = visible !== 0;
    if (status) status.textContent = visible === 0
      ? 'No accented characters matched that search.'
      : `${visible} ${visible === 1 ? 'character' : 'characters'} shown.`;
  }

  function findBuilderCharacter(letterCase: 'lower' | 'upper') {
    return builderCharacters.find((item) =>
      item.case === letterCase &&
      item.base.toLocaleLowerCase() === selectedBase &&
      item.accent === selectedAccent
    );
  }

  function updateBuilder() {
    if (selectedAccent && !builderCharacters.some((item) =>
      item.base.toLocaleLowerCase() === selectedBase && item.accent === selectedAccent
    )) {
      selectedAccent = '';
    }

    const lower = findBuilderCharacter('lower');
    const upper = findBuilderCharacter('upper');

    for (const button of builderBaseButtons) {
      button.setAttribute('aria-pressed', String(button.dataset.builderBase === selectedBase));
    }

    for (const button of builderAccentButtons) {
      const accent = button.dataset.builderAccent ?? '';
      const available = selectedBase
        ? builderCharacters.some((item) =>
            item.base.toLocaleLowerCase() === selectedBase && item.accent === accent
          )
        : true;

      button.disabled = !available;
      button.setAttribute('aria-pressed', String(accent === selectedAccent));
    }

    if (builderLower) {
      builderLower.textContent = lower?.character ?? '?';
      builderLower.dataset.builderCharacter = lower?.character ?? '';
      builderLower.disabled = !lower;
      builderLower.setAttribute(
        'aria-label',
        lower ? `Insert ${lower.label}: ${lower.character}` : 'Lowercase combination unavailable'
      );
    }

    if (builderUpper) {
      builderUpper.textContent = upper?.character ?? '?';
      builderUpper.dataset.builderCharacter = upper?.character ?? '';
      builderUpper.disabled = !upper;
      builderUpper.setAttribute(
        'aria-label',
        upper ? `Insert ${upper.label}: ${upper.character}` : 'Uppercase combination unavailable'
      );
    }

    if (builderStatus) {
      if (!selectedBase) {
        builderStatus.textContent = 'Choose a base letter and an accent type.';
      } else if (!selectedAccent) {
        builderStatus.textContent = `Choose an accent available for ${selectedBase.toLocaleUpperCase()}.`;
      } else if (lower || upper) {
        builderStatus.textContent = `Ready: ${selectedBase.toLocaleUpperCase()} with ${selectedAccent}.`;
      } else {
        builderStatus.textContent = 'That combination is not available in the reviewed set.';
      }
    }
  }

  function insertAtCursor(value: string) {
    if (!pad) return;

    const start = pad.selectionStart ?? pad.value.length;
    const end = pad.selectionEnd ?? start;
    pad.setRangeText(value, start, end, 'end');
    pad.focus();

    if (padStatus) {
      const count = Array.from(pad.value).length;
      padStatus.textContent = `${count} ${count === 1 ? 'character' : 'characters'} in the writing pad.`;
    }
  }

  search?.addEventListener('input', updateFilter, { passive: true });

  for (const button of builderBaseButtons) {
    button.addEventListener('click', () => {
      selectedBase = button.dataset.builderBase ?? '';
      updateBuilder();
    });
  }

  for (const button of builderAccentButtons) {
    button.addEventListener('click', () => {
      selectedAccent = button.dataset.builderAccent ?? '';
      updateBuilder();
    });
  }

  for (const button of [builderLower, builderUpper]) {
    button?.addEventListener('click', () => {
      const character = button.dataset.builderCharacter ?? '';
      if (!character) return;

      insertAtCursor(character);
      const item = builderCharacters.find((entry) => entry.character === character);
      rememberRecentCharacter({
        character,
        name: item?.label ?? 'Accented character'
      });
    });
  }

  for (const filter of filters) {
    filter.addEventListener('click', () => {
      selectedCase = filter.dataset.accentCase ?? 'all';
      for (const button of filters) {
        button.setAttribute('aria-pressed', String(button === filter));
      }
      updateFilter();
    });
  }

  for (const filter of languageFilters) {
    filter.addEventListener('click', () => {
      selectedLanguage = filter.dataset.accentLanguage ?? 'all';
      for (const button of languageFilters) {
        button.setAttribute('aria-pressed', String(button === filter));
      }
      updateFilter();
    });
  }

  for (const filter of letterFilters) {
    filter.addEventListener('click', () => {
      selectedLetter = filter.dataset.accentLetter ?? 'all';
      for (const button of letterFilters) {
        button.setAttribute('aria-pressed', String(button === filter));
      }
      updateFilter();
    });
  }

  copyVisible?.addEventListener('click', async () => {
    const value = keys.filter((key) => !key.hidden).map((key) => key.dataset.character ?? '').join('');
    if (!value) return;

    const original = copyVisible.textContent ?? 'Copy shown';
    const copied = await writeClipboard(value);
    if (copied) {
      copyVisible.textContent = 'Copied';
      copyVisible.dataset.copied = 'true';
      copyVisible.dataset.copyFailed = 'false';
    } else {
      copyVisible.textContent = 'Try again';
      copyVisible.dataset.copyFailed = 'true';
      copyVisible.dataset.copied = 'false';
    }

    window.setTimeout(() => {
      copyVisible.textContent = original;
      copyVisible.dataset.copied = 'false';
      copyVisible.dataset.copyFailed = 'false';
    }, 1400);
  });

  resetFilters?.addEventListener('click', () => {
    selectedCase = 'all';
    selectedLanguage = 'all';
    selectedLetter = 'all';
    if (search) search.value = '';

    for (const button of filters) {
      button.setAttribute('aria-pressed', String(button.dataset.accentCase === 'all'));
    }
    for (const button of languageFilters) {
      button.setAttribute('aria-pressed', String(button.dataset.accentLanguage === 'all'));
    }
    for (const button of letterFilters) {
      button.setAttribute('aria-pressed', String(button.dataset.accentLetter === 'all'));
    }

    updateFilter();
  });

  for (const key of keys) {
    key.addEventListener('click', async () => {
      const character = key.dataset.character ?? '';
      insertAtCursor(character);
      rememberRecentCharacter({
        character,
        name: key.getAttribute('aria-label')?.replace(/^Insert\s+/i, '').replace(/:\s*.$/u, '') || 'Accented character'
      });

      const copied = await writeClipboard(character);
      if (copied && padStatus && pad) {
        const count = Array.from(pad.value).length;
        padStatus.textContent = `Inserted and copied ${character}. ${count} ${count === 1 ? 'character' : 'characters'} in the writing pad.`;
      }
    });
  }

  pad?.addEventListener('input', () => {
    if (!padStatus || !pad) return;
    const count = Array.from(pad.value).length;
    padStatus.textContent = count === 0
      ? 'Nothing typed yet.'
      : `${count} ${count === 1 ? 'character' : 'characters'} in the writing pad.`;
  });

  copyPad?.addEventListener('click', async () => {
    if (!pad || !copyPad) return;
    const original = copyPad.textContent ?? 'Copy text';

    const copied = await writeClipboard(pad.value);
    if (copied) {
      copyPad.textContent = 'Copied';
      copyPad.dataset.copied = 'true';
      copyPad.dataset.copyFailed = 'false';
    } else {
      copyPad.textContent = 'Try again';
      copyPad.dataset.copyFailed = 'true';
      copyPad.dataset.copied = 'false';
    }

    window.setTimeout(() => {
      copyPad.textContent = original;
      copyPad.dataset.copied = 'false';
      copyPad.dataset.copyFailed = 'false';
    }, 1400);
  });

  clearPad?.addEventListener('click', () => {
    if (!pad) return;
    pad.value = '';
    pad.focus();
    if (padStatus) padStatus.textContent = 'Nothing typed yet.';
  });

  updateBuilder();
</script>
