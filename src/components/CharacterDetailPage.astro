---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyButton from './CopyButton.astro';
import type { CharacterDetail } from '../data/character-details';
import { allCuratedCharacters } from '../data/characters';

interface Props {
  detail: CharacterDetail;
}

const { detail } = Astro.props;
const categorySlug = detail.categoryHref.split('/').filter(Boolean).at(-1) ?? '';
const relatedCharacters = allCuratedCharacters
  .filter((item) => item.categorySlug === categorySlug && item.href && item.id !== detail.slug)
  .slice(0, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 2, name: 'Symbols', item: new URL('/symbols/', Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 3, name: detail.categoryName, item: new URL(detail.categoryHref, Astro.site ?? Astro.url.origin).href },
    { '@type': 'ListItem', position: 4, name: detail.commonName, item: new URL(`/symbols/${detail.slug}/`, Astro.site ?? Astro.url.origin).href }
  ]
};
---
<BaseLayout title={detail.title} description={detail.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <header class="content-header">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/symbols/">Symbols</a>
        <span aria-hidden="true">/</span>
        <a href={detail.categoryHref}>{detail.categoryName}</a>
        <span aria-hidden="true">/</span>
        {detail.commonName}
      </div>
      <h1>{detail.commonName} ({detail.character})</h1>
      <p class="lead">{detail.summary}</p>
    </div>
  </header>

  <section class="section" style="padding-top: 0" aria-labelledby="quick-answer">
    <div class="container">
      <div class="answer-card">
        <div class="answer-glyph" aria-label={detail.commonName}>{detail.character}</div>
        <div>
          <div class="reference-kicker">{detail.officialName} · {detail.codePoint}</div>
          <h2 id="quick-answer">Quick answer</h2>
          <p>{detail.quickAnswer}</p>
          <div class="answer-actions">
            <CopyButton value={detail.character} label={`Copy ${detail.commonName}`} />
            {detail.examples.slice(0, 2).map((example) => (
              <CopyButton value={example} label={`Copy ${example}`} />
            ))}
          </div>
        </div>
      </div>

      <div class="info-grid">
        <section class="info-card" aria-labelledby="platform-methods" data-typing-section>
          <h2 id="platform-methods">Typing methods</h2>
          <p class="typing-selector-intro">Choose an environment to highlight the most relevant verified method. All instructions stay visible.</p>
          <div class="typing-selector" role="group" aria-label="Highlight typing methods for" data-typing-selector>
            <button type="button" data-environment="all" aria-pressed="true">All methods</button>
            <button type="button" data-environment="windows" aria-pressed="false">Windows</button>
            <button type="button" data-environment="macos" aria-pressed="false">Mac</button>
            <button type="button" data-environment="word" aria-pressed="false">Microsoft Word</button>
          </div>
          <p class="typing-selector-status" data-typing-status aria-live="polite">Showing all verified methods.</p>
          {detail.methods.map((method) => (
            <div class="method-row" data-method-environment={method.environment} data-typing-method>
              <div class="method-heading-row">
                <h3>{method.label}</h3>
                <span class="method-badge" data-method-badge hidden>Best match</span>
              </div>
              <p>{method.instruction}</p>
              {method.note && <p class="method-note">{method.note}</p>}
              {method.sourceUrl && method.sourceLabel && (
                <p class="method-source">
                  <a href={method.sourceUrl} rel="noopener noreferrer">Source: {method.sourceLabel}</a>
                </p>
              )}
            </div>
          ))}
        </section>

        <section class="info-card" aria-labelledby="character-codes">
          <h2 id="character-codes">Character codes</h2>
          <table class="code-table">
            <tbody>
              {detail.codes.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  <td><code>{row.value}</code></td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="info-card" aria-labelledby="test-character">
          <h2 id="test-character">Test {detail.commonName.toLowerCase()}</h2>
          <p>Use this field to check rendering in your current browser and font.</p>
          <textarea class="test-field" aria-label={`${detail.commonName} test area`}>{detail.examples.join(' · ')}</textarea>
        </section>

        <section class="info-card" aria-labelledby="common-uses">
          <h2 id="common-uses">Uses and examples</h2>
          <div class="example-chips" aria-label="Copy-ready examples">
            {detail.examples.map((example) => <code>{example}</code>)}
          </div>
          {detail.notes.map((note) => <p>{note}</p>)}
        </section>
      </div>

      <section class="content-note" aria-labelledby="lookalikes">
        <h2 id="lookalikes">Similar-looking characters</h2>
        <div class="comparison-grid">
          {detail.lookalikes.map((item) => (
            <article class="comparison-card">
              <span class="comparison-glyph" aria-hidden="true">{item.character}</span>
              <div>
                <strong>{item.name}</strong>
                <code>{item.codePoint}</code>
                <p>{item.explanation}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      {relatedCharacters.length > 0 && (
        <section class="content-note" aria-labelledby="related-characters">
          <h2 id="related-characters">Related characters</h2>
          <p>Explore more reviewed characters from the same symbol family.</p>
          <div class="related-grid">
            {relatedCharacters.map((item) => (
              <a class="related-card" href={item.href}>
                <span class="related-glyph" aria-hidden="true">{item.character}</span>
                <span>
                  <strong>{item.name}</strong>
                  <small>{item.codePoint}</small>
                </span>
              </a>
            ))}
          </div>
          <p class="related-category-link"><a href={detail.categoryHref}>Browse all {detail.categoryName.toLowerCase()}</a></p>
        </section>
      )}

      <section class="content-note source-note" aria-labelledby="reviewed-sources">
        <h2 id="reviewed-sources">Reviewed sources</h2>
        <p>These references support the character identity, code values, and documented typing methods shown above.</p>
        <div class="source-links">
          {detail.sources.map((source) => (
            <a href={source.url} rel="noopener noreferrer">{source.label}</a>
          ))}
        </div>
      </section>

      <p class="verification-note">{detail.verifiedLabel}</p>
    </div>
  </section>
</BaseLayout>

<script>
  const typingSections = document.querySelectorAll<HTMLElement>('[data-typing-section]');

  for (const section of typingSections) {
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-environment]'));
    const methods = Array.from(section.querySelectorAll<HTMLElement>('[data-typing-method]'));
    const status = section.querySelector<HTMLElement>('[data-typing-status]');

    const labelFor = (environment: string) => {
      if (environment === 'windows') return 'Windows';
      if (environment === 'macos') return 'Mac';
      if (environment === 'word') return 'Microsoft Word';
      return 'all environments';
    };

    const applyEnvironment = (environment: string, persist = false) => {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.environment === environment));
      }

      for (const method of methods) {
        const badge = method.querySelector<HTMLElement>('[data-method-badge]');
        const isMatch = environment !== 'all' && method.dataset.methodEnvironment === environment;
        method.dataset.recommended = String(isMatch);
        if (badge) badge.hidden = !isMatch;
      }

      if (status) {
        status.textContent = environment === 'all'
          ? 'Showing all verified methods.'
          : `Highlighting verified methods for ${labelFor(environment)}. Other methods remain visible.`;
      }

      if (persist) {
        try {
          localStorage.setItem('character-toolbox.typing-environment', environment);
        } catch {
          // Preferences are optional; the page works without localStorage.
        }
      }
    };

    let initialEnvironment = 'all';

    try {
      const stored = localStorage.getItem('character-toolbox.typing-environment');
      if (stored && ['all', 'windows', 'macos', 'word'].includes(stored)) {
        initialEnvironment = stored;
      } else if (/Windows/i.test(navigator.userAgent)) {
        initialEnvironment = 'windows';
      } else if (/Macintosh|Mac OS X/i.test(navigator.userAgent)) {
        initialEnvironment = 'macos';
      }
    } catch {
      // Device highlighting is a progressive enhancement.
    }

    applyEnvironment(initialEnvironment);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        applyEnvironment(button.dataset.environment ?? 'all', true);
      });
    }
  }
</script>
