{
  "name": "universal-character-keyboard-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run seo:verify && npm run deploy:verify && npm run test:e2e",
    "unicode:sync": "node scripts/unicode/sync-unicode.mjs",
    "unicode:verify": "node scripts/unicode/verify-unicode.mjs",
    "unicode:index": "node scripts/unicode/build-search-index.mjs",
    "unicode:prepare": "npm run unicode:sync && npm run unicode:verify && npm run unicode:index",
    "seo:verify": "node scripts/seo/verify-indexation.mjs",
    "deploy:verify": "node scripts/deploy/verify-production-config.mjs",
    "unicode:restore": "node scripts/unicode/restore-search-index.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.2"
  }
}
